{
  "name": "@nrynss/chaaya",
  "version": "0.6.0",
  "description": "A Svelte 5 kit of behaviour, not looks. Each app keeps its own visual identity.",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node build/index.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint --no-warn-ignored $(git ls-files --cached --others --exclude-standard | grep -E '\\.(js|mjs|cjs|ts|svelte)$' | while IFS= read -r f; do [ -f \"$f\" ] && printf '%s\\n' \"$f\"; done)",
    "test": "vitest run",
    "test:browser": "playwright test",
    "package": "svelte-kit sync && svelte-package -i src/lib -o dist",
    "prepare": "npm run package",
    "publint": "publint"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "default": "./dist/tokens/index.js"
    },
    "./tokens/reference.css": {
      "default": "./dist/tokens/reference.css"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "default": "./dist/theme/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    },
    "./sveltekit": {
      "types": "./dist/sveltekit/index.d.ts",
      "svelte": "./dist/sveltekit/index.js",
      "default": "./dist/sveltekit/index.js"
    },
    "./sse": {
      "types": "./dist/core/sse/index.d.ts",
      "default": "./dist/core/sse/index.js"
    },
    "./upload": {
      "types": "./dist/upload/index.d.ts",
      "default": "./dist/upload/index.js"
    },
    "./direct-upload": {
      "types": "./dist/direct-upload/index.d.ts",
      "default": "./dist/direct-upload/index.js"
    },
    "./audio": {
      "types": "./dist/audio/index.d.ts",
      "default": "./dist/audio/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./guard": {
      "types": "./dist/guard/index.d.ts",
      "default": "./dist/guard/index.js"
    },
    "./transcript": {
      "types": "./dist/transcript/index.d.ts",
      "default": "./dist/transcript/index.js"
    },
    "./timeline": {
      "types": "./dist/timeline/index.d.ts",
      "default": "./dist/timeline/index.js"
    },
    "./capture": {
      "types": "./dist/capture/index.d.ts",
      "default": "./dist/capture/index.js"
    },
    "./share": {
      "types": "./dist/share/index.d.ts",
      "default": "./dist/share/index.js"
    },
    "./priced": {
      "types": "./dist/priced/index.d.ts",
      "default": "./dist/priced/index.js"
    },
    "./shortcuts": {
      "types": "./dist/shortcuts/index.d.ts",
      "default": "./dist/shortcuts/index.js"
    },
    "./history": {
      "types": "./dist/history/index.d.ts",
      "default": "./dist/history/index.js"
    },
    "./keel": {
      "types": "./dist/adapters/keel/index.d.ts",
      "default": "./dist/adapters/keel/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0",
    "axe-core": "^4.13.0",
    "bits-ui": "^2.0.0",
    "svelte": "^5.7.0"
  },
  "peerDependenciesMeta": {
    "@sveltejs/kit": {
      "optional": true
    },
    "bits-ui": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-node": "^5.0.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/node": "^26.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "publint": "^0.3.24",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.1"
  }
}
