{
  "name": "@nrynss/chaaya",
  "version": "0.0.0",
  "description": "A Svelte 5 kit of behaviour, not looks. Each app keeps its own visual identity.",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node build/index.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint $(git ls-files --cached --others --exclude-standard | grep -E '\\.(js|mjs|cjs|ts|svelte)$' | while IFS= read -r f; do [ -f \"$f\" ] && printf '%s\\n' \"$f\"; done)",
    "test": "vitest run",
    "test:browser": "playwright test",
    "package": "svelte-package -i src/lib -o dist",
    "prepare": "npm run package",
    "publint": "publint"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "svelte": "./dist/tokens/index.js",
      "default": "./dist/tokens/index.js"
    },
    "./tokens/reference.css": {
      "default": "./dist/tokens/reference.css"
    },
    "./wire": {
      "types": "./dist/wire/index.d.ts",
      "svelte": "./dist/wire/index.js",
      "default": "./dist/wire/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "svelte": "./dist/theme/index.js",
      "default": "./dist/theme/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "svelte": "./dist/api/index.js",
      "default": "./dist/api/index.js"
    },
    "./job": {
      "types": "./dist/job/index.d.ts",
      "svelte": "./dist/job/index.js",
      "default": "./dist/job/index.js"
    },
    "./audio": {
      "types": "./dist/audio/index.d.ts",
      "svelte": "./dist/audio/index.js",
      "default": "./dist/audio/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "svelte": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "peerDependencies": {
    "axe-core": "^4.13.0",
    "bits-ui": "^2.0.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-node": "^5.0.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/node": "^26.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "publint": "^0.3.24",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.1"
  }
}
